# Settings
theme = tokyonight
font-family = Monaspace Neon NF
font-size = 16
font-feature = 'calt', 'ss01', 'ss03', 'ss07', 'ss09', 'liga', 'cv01' 2
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor
window-padding-x = 15
window-padding-y = 15
window-width = 9999
window-height = 9999
macos-titlebar-style = tabs
confirm-close-surface = false
macos-option-as-alt = true
mouse-hide-while-typing = true

# Keybinds
## Global Keybinds
keybind = global:alt+space=toggle_visibility

## Pane Management
### Focus Panes
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:down
keybind = ctrl+b>k=goto_split:up
keybind = ctrl+b>l=goto_split:right

### Splitting, Closing, Zooming
keybind = ctrl+b>z=toggle_split_zoom
keybind = ctrl+b>x=close_surface
keybind = ctrl+b>backslash=new_split:right
keybind = ctrl+b>shift+backslash=new_split:left
keybind = ctrl+b>minus=new_split:down
keybind = ctrl+b>shift+minus=new_split:up

### Resizing
keybind = ctrl+b>r=activate_key_table:resize
keybind = resize/h=resize_split:left,10
keybind = resize/j=resize_split:down,10
keybind = resize/k=resize_split:up,10
keybind = resize/l=resize_split:right,10
keybind = resize/equal=equalize_splits
keybind = resize/escape=deactivate_key_table
keybind = resize/enter=deactivate_key_table

## Tab Management
### Create and Switch
keybind = ctrl+b>t=new_tab
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab

### Move Tabs
keybind = ctrl+b>comma=move_tab:-1
keybind = ctrl+b>period=move_tab:1

