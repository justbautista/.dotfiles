# -- UI --

theme = tokyonight
font-family = Monaspace Neon NF
font-size = 16
font-feature = 'calt', 'ss01', 'ss03', 'ss07', 'ss09', 'liga', 'cv01' 2
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor
# background-opacity = 0.9
# background-blur = 10
window-padding-x = 15
window-padding-y = 15
window-width = 9999
window-height = 9999
macos-titlebar-style = tabs
confirm-close-surface = false
macos-option-as-alt = true
mouse-hide-while-typing = true

# -- Keybinds --

keybind = super+r=reload_config

## Global Keybinds
keybind = global:alt+space=toggle_visibility

## Pane Management
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right

keybind = ctrl+space>m=toggle_split_zoom
keybind = ctrl+space>w=close_surface
keybind = ctrl+space>v=new_split:right
keybind = ctrl+space>s=new_split:down

keybind = ctrl+space>r=equalize_splits
keybind = ctrl+up=resize_split:up,10
keybind = ctrl+left=resize_split:left,10
keybind = ctrl+down=resize_split:down,10
keybind = ctrl+right=resize_split:right,10

## Tab Management
keybind = ctrl+space>t=new_tab
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab

