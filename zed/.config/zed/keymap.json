// See contexts: https://github.com/zed-industries/zed/issues/14718
// Vim contexts: https://zed.dev/docs/vim#selecting-the-correct-context
// Action sequence (run multiple commands) pr: https://github.com/zed-industries/zed/pull/39261
[
    // Global unbindings
    {
        "bindings": {
            "J": null, // I don't use join lines in vim
            "cmd-g": null, // I don't search next match with this map
            "g i": null, // I don't use insert at previous in vim
            "ctrl-h": null, // Conflicts with my keybinds
            "ctrl-l": null, // Conflicts with my keybinds
        },
    },
    // Global bindings
    {
        "bindings": {
            "ctrl-j": "menu::SelectNext", // Move down on menus
            "ctrl-k": "menu::SelectPrevious", // Move down on menus
        },
    },
    // Shortcuts
    {
        "context": "Workspace || Editor",
        "bindings": {
            "cmd-G": "git_panel::ToggleFocus", // Git panel
            "cmd-?": "workspace::ToggleRightDock", // Close agent panel
        },
    },
    // Close left dock when in ProjectPanel
    {
        "context": "Workspace && left_dock == ProjectPanel",
        "bindings": {
            "cmd-E": "workspace::ToggleLeftDock",
        },
    },
    // Close left dock when in GitPanel
    {
        "context": "Workspace && left_dock == GitPanel",
        "bindings": {
            "cmd-G": "workspace::ToggleLeftDock",
        },
    },
    // Move up/down through autocomplete with j/k
    {
        "context": "Editor && (showing_code_actions || showing_completions)",
        "bindings": {
            "ctrl-j": "editor::ContextMenuNext",
            "ctrl-k": "editor::ContextMenuPrevious",
        },
    },
    // Window navigation
    {
        "context": "!Picker && !(showing_code_actions || showing_completions)",
        "bindings": {
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-l": "workspace::ActivatePaneRight",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-j": "workspace::ActivatePaneDown",
        },
    },
    // Project panel navigation and commands
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "a": "project_panel::NewFile",
            "d": "project_panel::Delete",
            "x": "project_panel::Cut",
            "y": "project_panel::Copy",
            "p": "project_panel::Paste",
            "r": "project_panel::Rename",
            "-": "project_panel::CollapseSelectedEntry",
            "q": "workspace::ToggleLeftDock",
            "o": "project_panel::Open",
            "enter": ["action::Sequence", ["project_panel::OpenPermanent", "workspace::ToggleLeftDock"]],
        },
    },
    // Editor keybinds (vim and shortcuts)
    {
        "context": "Editor && VimControl && !VimWaiting && !menu",
        "bindings": {
            "space space": "file_finder::Toggle",
            "space tab": "tab_switcher::Toggle",
            "-": "vim::ToggleProjectPanelFocus",
            "alt-z": "editor::ToggleSoftWrap",
            "cmd-enter": "assistant::InlineAssist",
            "space a": "editor::SelectAll",
        },
    },
    // Enable MiniQuotes and MiniBrackets
    {
        "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
        "bindings": {
            "q": "vim::MiniQuotes",
            "b": "vim::MiniBrackets",
        },
    },
    // Move selected lines up/down
    {
        "context": "vim_mode == visual",
        "bindings": {
            "shift-k": "editor::MoveLineUp",
            "shift-j": "editor::MoveLineDown",
        },
    },
    // No editor keybinds
    {
        "context": "EmptyPane || SharedScreen",
        "bindings": {
            "space space": "file_finder::Toggle",
            "-": "vim::ToggleProjectPanelFocus",
        },
    },
]
