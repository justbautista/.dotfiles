{
    // Vim
    "vim_mode": true,
    "vim": {
        "use_smartcase_find": true,
        "use_system_clipboard": "always",
        "toggle_relative_line_numbers": true,
    },
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 1000,

    // Saving
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "format_on_save": "on",

    // AI
    "agent_servers": {
        "opencode": {
            "default_mode": "plan",
            "favorite_models": [
                "openai/gpt-5.2-codex/medium",
                "openai/gpt-5.2-codex/high",
                "openai/gpt-5.2/medium",
                "openai/gpt-5.2/high",
                "opencode/kimi-k2.5-free",
                "opencode/glm-4.7-free",
            ],
            "type": "registry",
        },
        "codex": {
            "favorite_models": ["gpt-5.2-codex/medium", "gpt-5.2-codex/high", "gpt-5.2/medium", "gpt-5.2/high"],
        },
    },
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-4.1",
        },
        "commit_message_model": {
            "provider": "copilot_chat",
            "model": "gpt-4.1",
        },
        "default_view": "thread",
        "tool_permissions": {
            "default": "confirm",
        },
    },
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle",
    },

    // Fonts
    "buffer_font_family": "Monaspace Neon NF",
    "buffer_font_size": 14,
    "buffer_font_features": {
        "calt": true,
        "ss01": true,
        "ss03": true,
        "ss07": true,
        "ss09": true,
        "liga": true,
        "cv01": 2,
    },
    "ui_font_family": "IBM Plex Sans",
    "ui_font_size": 15,
    "agent_ui_font_size": 16,

    // Theme
    "icon_theme": "Symbols Icon Theme",
    "theme": "Tokyo Night",
    "theme_overrides": {
        "Tokyo Night": {
            "editor.highlighted_line.background": "#414868", // Make 'get all references' highlight more visible
        },
    },

    // Editor
    "semantic_tokens": "combined",
    "auto_signature_help": true,
    "gutter": {
        "runnables": false,
    },
    "tab_bar": {
        "show": false,
    },
    "inline_code_actions": false,
    "toolbar": {
        "quick_actions": false,
        "selections_menu": false,
        "code_actions": false,
    },
    "indent_guides": {
        "active_line_width": 2,
        "coloring": "indent_aware",
    },
    "extend_comment_on_newline": false,
    "double_click_in_multibuffer": "open",
    "pane_split_direction_horizontal": "down",
    "pane_split_direction_vertical": "right",
    "tab_size": 4,
    "hard_tabs": false,
    "colorize_brackets": true,
    "unnecessary_code_fade": 0.5,
    "use_smartcase_search": true,

    // Wrap
    "preferred_line_length": 120,
    "soft_wrap": "preferred_line_length",
    "show_wrap_guides": true,
    "wrap_guides": [120],

    // Files
    "close_on_file_delete": true,
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/.jj",
        "**/.sl",
        "**/.repo",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/__pycache__",
    ],

    // LSP and Formatters
    "languages": {
        "Python": {
            "language_servers": ["ruff", "!basedpyright", "ty"],
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff",
                },
                {
                    "code_action": "source.fixAll.ruff",
                },
                {
                    "language_server": {
                        "name": "ruff",
                    },
                },
            ],
        },
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
        },
    },

    // Privacy
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    // Other Panels
    "line_indicator_format": "long",
    "search": {
        "button": false,
        "center_on_match": true,
        "regex": true,
    },
    "terminal": {
        "dock": "bottom",
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "default",
            },
        },
    },
    "title_bar": {
        "show_branch_icon": true,
        "show_branch_name": true,
        "show_project_items": true,
        "show_onboarding_banner": true,
        "show_user_picture": true,
        "show_user_menu": true,
        "show_sign_in": true,
        "show_menus": true,
    },
    "project_panel": {
        "scrollbar": {
            "show": "auto",
        },
        "hide_root": true,
        "starts_open": true,
    },
    "git_panel": {
        "tree_view": false,
        "scrollbar": {
            "show": "auto",
        },
    },
    "outline_panel": {
        "button": false,
    },
}
