{
    // === Agent & AI ===
    "edit_predictions": {
        "mode": "subtle",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
            "enterprise_uri": null
        },
        "enabled_in_text_threads": false
    },
    "agent": {
        "default_profile": "ask",
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-4.1"
        }
    },
    "agent_ui_font_size": 17,
    "context_servers": {
        "mcp-server-context7": {
            "enabled": true,
            "settings": {
                "default_minimum_tokens": "10000"
            }
        }
    },
    "features": {
        "edit_prediction_provider": "zed" // copilot, zed, supermaven
    },

    // === Appearance & Editor ===
    "theme": {
        "mode": "dark",
        "light": "Tokyo Night Light",
        "dark": "Tokyo Night"
    },
    "theme_overrides": {
        "Tokyo Night": {
            "editor.highlighted_line.background": "#414868" // Make 'get all references' highlight more visible
        }
    },
    "icon_theme": "Symbols Icon Theme",
    "ui_font_size": 15,
    "ui_font_family": "IBM Plex Sans",
    "buffer_font_size": 14,
    "buffer_font_family": "Monaspace Neon NF",
    "buffer_font_features": {
        "calt": true,
        "ss01": true,
        "ss03": true,
        "ss07": true,
        "ss09": true,
        "liga": true,
        "cv01": 2
    },
    "vim_mode": true,
    "auto_signature_help": true,
    "inline_code_actions": false,
    "unnecessary_code_fade": 0.5,
    "vertical_scroll_margin": 100,
    "colorize_brackets": true,
    "indent_guides": {
        "enabled": true,
        "line_width": 1, // Width of guides in pixels [1-10]
        "active_line_width": 2, // Width of active guide in pixels [1-10]
        "coloring": "indent_aware", // disabled, fixed, indent_aware
        "background_coloring": "disabled" // disabled, indent_aware
    },
    "tab_size": 4,
    "soft_wrap": "preferred_line_length",
    "preferred_line_length": 120,
    "show_wrap_guides": true,
    "format_on_save": "off",
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },

    // === UI ===
    "toolbar": {
        "breadcrumbs": true, // Whether to show breadcrumbs.
        "quick_actions": false, // Whether to show quick action buttons.
        "selections_menu": false, // Whether to show the Selections menu
        "agent_review": false, // Whether to show agent review buttons
        "code_actions": false // Whether to show code action buttons
    },
    "tab_bar": {
        "show": false // Show/hide the tab bar
    },
    "tabs": {
        "file_icons": true,
        "git_status": true
    },
    "max_tabs": 5,
    "title_bar": {
        "show_branch_icon": true, // Show/hide branch icon beside branch switcher
        "show_branch_name": true, // Show/hide branch name
        "show_project_items": true, // Show/hide project host and name
        "show_onboarding_banner": true, // Show/hide onboarding banners
        "show_user_picture": true, // Show/hide user avatar
        "show_sign_in": true, // Show/hide sign-in button
        "show_menus": true // Show/hide menus
    },
    "terminal": {
        "font_family": "Monaspace Neon NF",
        "font_size": 14,
        "blinking": "on",
        "toolbar": { "breadcrumbs": false },
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "default"
            }
        }
    },

    // === Diagnostics & Privacy ===
    "diagnostics": {
        "inline": {
            "enabled": true
        }
    },
    "telemetry": {
        "metrics": false,
        "diagnostics": false
    },

    // LSP
    "languages": {
        "Python": {
            "language_servers": ["ruff", "pyright"],
            "format_on_save": "off",
            "formatter": [
                { "code_action": "source.organizeImports.ruff" },
                { "code_action": "source.fixAll.ruff" },
                { "language_server": { "name": "ruff" } }
            ]
        }
    },
    "lsp": {
        "pyright": {
            "settings": {
                "python": {
                    "pythonPath": ".venv/bin/python"
                }
            }
        }
    }
}
